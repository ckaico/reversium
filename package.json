{
  "name": "reversium",
  "version": "0.1.0",
  "description": "Reverse engineer everything you lawfully have. Saved, versioned blueprints and a build-and-compare loop, as an MCP server. Built on REA for software.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "reversium": "./bin/reversium.js"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "AUP.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node --format esm",
    "smoke": "bun run scripts/smoke.ts",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "mcp",
    "reverse-engineering",
    "blueprint",
    "rea",
    "skills",
    "interoperability"
  ],
  "homepage": "https://reversium.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckaico/reversium.git"
  },
  "bugs": {
    "url": "https://github.com/ckaico/reversium/issues"
  },
  "author": {
    "name": "Christian Kai",
    "url": "https://reversium.com"
  }
}
